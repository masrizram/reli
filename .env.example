# RELI environment variables.
# Copy this file to `.env.local` and fill in your own values.
# Do NOT commit `.env.local` — it is gitignored.

# Supabase project URL (e.g. https://yourproject.supabase.co)
VITE_SUPABASE_URL=

# Supabase public anon key. Safe for the client bundle ONLY when Row Level
# Security policies are enabled on your tables. Never use the service_role
# key in client code.
VITE_SUPABASE_ANON_KEY=
